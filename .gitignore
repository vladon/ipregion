.deploy_*_key
.deploy_*_key.pub
.omp/

# graphify knowledge graph: durable artifacts are committed, regenerable
# (graph.html) and machine-local (.graphify_python, .graphify_root) are not
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/cost.json
!graphify-out/.graphify_labels.json
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/ast/
!graphify-out/cache/semantic/
